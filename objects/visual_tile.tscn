# I just want a place to put all this
enum BorderStyle {DOT, SQUARE}
var border_style:BorderStyle = BorderStyle.DOT
var border_color:Color
var background_color:Color
var letter_color:Color
var display_letter:bool

@onready var material:ShaderMaterial = get_parent().find_child(\"Panel\").material as ShaderMaterial

# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	pass # Replace with function body.


# Called every frame. 'delta' is the elapsed time since the previous frame.
func _process(delta: float) -> void:
	var current_radius:float = material.get_shader_parameter(\"radius\")
	#material.set_shader_parameter(.)
"

